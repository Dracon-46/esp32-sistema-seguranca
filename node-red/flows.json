  {
    "id": "fn_tele",
    "type": "function",
    "z": "flowtab",
    "name": "Distribui telemetria",
    "func": "\n// A telemetria chega como JSON a cada 5 s.\n// Guardamos o instante para o watchdog de comunicacao.\nlet d = msg.payload;\nif (typeof d === \"string\") { try { d = JSON.parse(d); } catch (e) { return null; } }\n\nflow.set(\"ultimaTelemetria\", Date.now());\nflow.set(\"telemetria\", d);\n\nconst movimento = { payload: d.movimento ? \"\\uD83D\\uDEB6 MOVIMENTO\" : \"\\u2713 Sem movimento\" };\nconst porta     = { payload: d.porta === \"ABERTA\" ? \"\\uD83D\\uDEAA ABERTA\" : \"\\uD83D\\uDD12 Fechada\" };\nconst rssi      = { payload: Number(d.rssi) || -100 };\nconst sirene    = { payload: d.sirene ? \"\\uD83D\\uDD0A LIGADA\" : \"Desligada\" };\nconst grafRssi  = { topic: \"RSSI (dBm)\", payload: Number(d.rssi) || -100 };\n\nreturn [movimento, porta, rssi, sirene, grafRssi];\n",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 220,
    "wires": [
