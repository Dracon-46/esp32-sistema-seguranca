  {
    "id": "fn_watchdog",
    "type": "function",
    "z": "flowtab",
    "name": "Watchdog de comunicacao",
    "func": "\n// Se nao chega heartbeat/telemetria ha mais de 10 s, o dispositivo\n// e considerado OFFLINE e um alerta e gerado uma unica vez.\nconst agora = Date.now();\nconst ultimo = Math.max(flow.get(\"ultimoHeartbeat\") || 0,\n                        flow.get(\"ultimaTelemetria\") || 0);\nconst lwt = flow.get(\"conexao\") || \"offline\";\n\nconst online = (lwt === \"online\") && (agora - ultimo < 10000);\nconst anterior = flow.get(\"online\");\nflow.set(\"online\", online);\n\nconst badge = {\n    payload: online ? \"\\uD83D\\uDFE2 ONLINE\" : \"\\uD83D\\uDD34 OFFLINE\",\n    cor: online ? \"#2ecc71\" : \"#e74c3c\"\n};\n\n// Alerta somente na transicao online -> offline\nlet alerta = null;\nif (anterior === true && online === false) {\n    alerta = { payload: \"Central de alarme OFFLINE - comunicacao perdida\",\n               topic: \"\\uD83D\\uDCE1 COMUNICACAO\" };\n}\n\nnode.status({ fill: online ? \"green\" : \"red\", shape: \"dot\",\n              text: online ? \"online\" : \"offline\" });\n\nreturn [badge, alerta];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 700,
    "wires": [
      [
        "tpl_conexao"
      ],
      [
        "toast_alerta"
      ]
    ]
  },
  {
    "id": "tpl_conexao",
    "type": "ui_template",
    "z": "flowtab",
    "group": "g_status",
    "name": "Status da comunicacao",
    "order": 3,
