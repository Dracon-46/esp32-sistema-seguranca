  {
    "id": "fn_status",
    "type": "function",
    "z": "flowtab",
    "name": "Traduz estado -> UI",
    "func": "\n// Recebe o estado textual publicado pelo ESP32 e prepara:\n//  saida 1 -> texto do estado\n//  saida 2 -> badge colorido\n//  saida 3 -> valor numerico para o grafico\nconst estado = String(msg.payload).trim().toUpperCase();\n\nconst mapa = {\n    \"DESARMADO\": { cor: \"#2ecc71\", nivel: 0, icone: \"\\uD83D\\uDFE2\" },\n    \"SAINDO\":    { cor: \"#3498db\", nivel: 1, icone: \"\\uD83D\\uDD35\" },\n    \"ARMADO\":    { cor: \"#3498db\", nivel: 2, icone: \"\\uD83D\\uDD12\" },\n    \"ENTRANDO\":  { cor: \"#f39c12\", nivel: 3, icone: \"\\u26A0\\uFE0F\" },\n    \"ALARME\":    { cor: \"#e74c3c\", nivel: 4, icone: \"\\uD83D\\uDD34\" },\n    \"BLOQUEADO\": { cor: \"#f1c40f\", nivel: 3, icone: \"\\uD83D\\uDEAB\" }\n};\nconst info = mapa[estado] || { cor: \"#888888\", nivel: 0, icone: \"?\" };\n\nflow.set(\"estado\", estado);\n\nconst texto  = { payload: info.icone + \"  \" + estado };\nconst badge  = { payload: estado, cor: info.cor };\nconst grafico = { topic: \"Nivel de alerta\", payload: info.nivel };\n\nreturn [texto, badge, grafico];\n",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 100,
    "wires": [
      [
        "txt_estado",
        "fn_regra"
      ],
      [
        "tpl_estado"
      ],
      [
        "chart_nivel"
      ]
    ]
  },
