  {
    "id": "fn_alerta",
    "type": "function",
    "z": "flowtab",
    "name": "Trata alerta",
    "func": "\n// Todo alerta vira: notificacao na tela + linha no historico.\nconst texto = String(msg.payload);\nconst hora  = new Date().toLocaleTimeString(\"pt-BR\");\n\nlet hist = flow.get(\"historico\") || [];\nhist.unshift({ hora: hora, texto: texto });\nif (hist.length > 12) hist = hist.slice(0, 12);\nflow.set(\"historico\", hist);\n\nnode.status({ fill: \"red\", shape: \"dot\", text: texto });\n\nconst toast = { payload: texto, topic: \"\\u26A0\\uFE0F ALERTA\" };\nconst lista = { payload: hist };\nreturn [toast, lista];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 480,
    "wires": [
      [
        "toast_alerta"
      ],
      [
        "tpl_hist"
      ]
    ]
  },
  {
    "id": "fn_evento",
    "type": "function",
    "z": "flowtab",
    "name": "Registra evento",
    "func": "\n// Log estruturado: entra JSON, sai linha legivel para o historico.\nlet e = msg.payload;\nif (typeof e === \"string\") { try { e = JSON.parse(e); } catch (err) { return null; } }\n\nconst hora = new Date().toLocaleTimeString(\"pt-BR\");\nconst linha = e.tipo + \" (\" + e.origem + \") - \" + e.descricao;\n\nlet hist = flow.get(\"historico\") || [];\nhist.unshift({ hora: hora, texto: linha });\nif (hist.length > 12) hist = hist.slice(0, 12);\nflow.set(\"historico\", hist);\n\nreturn { payload: hist };\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 540,
    "wires": [
      [
        "tpl_hist"
      ]
    ]
  },
